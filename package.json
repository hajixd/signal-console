{
  "name": "tradingbot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "firebase:sync": "tsx scripts/firebase-sync.ts",
    "firebase:live-config": "tsx scripts/save-live-config.ts",
    "prepare:data": "python backtest-engine/runner.py prepare-data",
    "backtest": "python backtest-engine/runner.py run-backtests",
    "refresh": "python backtest-engine/runner.py prepare-data && python backtest-engine/runner.py run-backtests",
    "import:legacy": "python backtest-engine/runner.py prepare-data --source ..\\signal-console\\data"
  },
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "lightweight-charts": "^5.1.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
