{
  "name": "tradingbot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "simple:import": "node --env-file=.env.local --import tsx scripts/import-simple-strategies.ts",
    "r2:sync": "node --env-file=.env.local --import tsx scripts/r2-sync.ts",
    "storage:check": "node --env-file=.env.local --import tsx scripts/storage-provider-check.ts",
    "storage:migrate": "node --env-file=.env.local --import tsx scripts/migrate-firebase-to-turso-r2.ts",
    "turso:migrate": "node --env-file=.env.local --import tsx scripts/turso-migrate.ts",
    "firebase:pull": "node --env-file=.env.local --import tsx scripts/firebase-pull.ts",
    "firebase:sync": "node --env-file=.env.local --import tsx scripts/firebase-sync.ts",
    "firebase:live-config": "node --env-file=.env.local --import tsx scripts/save-live-config.ts",
    "data:capture-tails": "node --env-file=.env.local --import tsx scripts/capture-data-tails.ts",
    "data:live-tails": "node --import tsx scripts/build-live-data-tails.ts",
    "market-data:refresh-live": "node --env-file=.env.local --import tsx scripts/refresh-live-market-data.ts",
    "market-data:sync-firebase": "node --env-file=.env.local --import tsx scripts/incremental-firebase-market-data.ts",
    "data:intraday": "node --env-file=.env.local --import tsx scripts/download-intraday-data.ts",
    "prepare:data": "python backtest-engine/runner.py prepare-data",
    "backtest": "python backtest-engine/runner.py run-backtests",
    "find:op": "python backtest-engine/report_high_pf_candidates.py",
    "refresh": "python backtest-engine/runner.py prepare-data && python backtest-engine/runner.py run-backtests",
    "import:legacy": "python backtest-engine/runner.py prepare-data --source ..\\signal-console\\data"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1061.0",
    "@aws-sdk/lib-storage": "^3.1062.0",
    "@libsql/client": "^0.17.3",
    "firebase-admin": "^13.6.0",
    "lightweight-charts": "^5.1.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "overrides": {
    "@tootallnate/once": "3.0.1",
    "postcss": "8.5.10"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
