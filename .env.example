# Bridge execution paths for terminal/protocol platforms
MT5_SYMBOL_MAP=
MT5_LOT_MAP=

# MT5 EA (pull-based) execution — the reliable path. The in-terminal Expert
# Advisor polls /ea/orders/pending with Authorization: Bearer ${EA_INGEST_TOKEN}.
# To route forex here, set AUTO_TRADE_FOREX_PROVIDER=mt5_ea above.
EA_INGEST_TOKEN=
MT5_EA_AUTO_TRADE_ENABLED=true
MT5_EA_AUTO_TRADE_DRY_RUN=false
# Slug identifying the MT5 account; must match the EA's BridgeAccountId input.
MT5_EA_DEMO_ACCOUNT_ID=mt5-demo-100k
# Risk-based lot sizing off the account balance (percent: 0.5 == 0.5%).
MT5_EA_RISK_PER_TRADE_PCT=0.5
# Fallback balance used until the EA reports live balance via /ea/state.
MT5_EA_ACCOUNT_BALANCE=100000
# Broker lot constraints + a hard upper cap.
MT5_EA_MIN_LOT=0.01
MT5_EA_LOT_STEP=0.01
MT5_EA_MAX_LOT=50
# Optional broker symbol remap, e.g. EURUSD:EURUSD.r,GBPJPY:GBPJPYm
MT5_EA_SYMBOL_MAP=
# Optional per-symbol overrides: fixed lots (bypass risk calc) and calibrated
# USD-per-pip-per-1.0-lot to make risk sizing broker-exact.
MT5_EA_LOT_OVERRIDE=
MT5_EA_PIP_VALUE_OVERRIDE=
# Queue timing: order TTL before it expires unclaimed, and stale-claim redelivery.
MT5_EA_ORDER_TTL_SECONDS=120
MT5_EA_CLAIM_STALE_SECONDS=30
CTRADER_AUTO_TRADE_ENABLED=true
CTRADER_AUTO_TRADE_DRY_RUN=false
CTRADER_BRIDGE_URL=
CTRADER_BRIDGE_SECRET=
CTRADER_ACCOUNT_ID=
CTRADER_SYMBOL_MAP=
CTRADER_SIZE_MAP=
RITHMIC_AUTO_TRADE_ENABLED=true
RITHMIC_AUTO_TRADE_DRY_RUN=false
RITHMIC_BRIDGE_URL=
RITHMIC_BRIDGE_SECRET=
RITHMIC_ACCOUNT_ID=
RITHMIC_SYMBOL_MAP=
RITHMIC_SIZE_MAP=

